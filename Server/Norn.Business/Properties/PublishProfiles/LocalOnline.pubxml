<Project>
  <PropertyGroup>
    <!-- Visual Studio 右键 Publish 选择此 Profile；发布目录与 Test/Build 输出分开。 -->
    <Configuration>Release</Configuration>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>$(MSBuildProjectDirectory)/../.artifacts/publish/online/</PublishDir>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>
