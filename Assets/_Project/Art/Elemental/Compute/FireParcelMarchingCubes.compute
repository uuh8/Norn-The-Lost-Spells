#pragma kernel ClearFireSurface
#pragma kernel ExtractFireSurface
#pragma kernel BuildFireDrawArgs

Texture3D<float> _FireDensity;
SamplerState sampler_FireDensity;
struct SurfaceVertex { float3 positionWS; float pad0; float3 normalWS; float pad1; };
struct SurfaceTriangle { SurfaceVertex v0; SurfaceVertex v1; SurfaceVertex v2; };
RWStructuredBuffer<SurfaceTriangle> _FireSurfaceTriangles;
RWStructuredBuffer<uint> _TriangleCounter;
RWStructuredBuffer<uint> _OverflowCounter;
RWStructuredBuffer<uint> _IndirectArguments;
int _GridResolutionX, _GridResolutionY, _GridResolutionZ;
float3 _WorldOrigin;
float3 _VoxelSize;
float _IsoLevel;
int _MaximumTriangleCount;

float Sample(int3 p)
{
    p = clamp(p, int3(0,0,0), int3(_GridResolutionX-1,_GridResolutionY-1,_GridResolutionZ-1));
    return _FireDensity.Load(int4(p,0));
}
float3 NormalAt(float3 gridPosition)
{
    // Trilinear Filtering 让法线连续，不能先把交点 round 到格心（会形成明显晶体切面）。
    float3 size = float3(_GridResolutionX, _GridResolutionY, _GridResolutionZ);
    float3 uv = (gridPosition + 0.5) / size, stepUV = 0.5 / size;
    float3 g = float3(
        _FireDensity.SampleLevel(sampler_FireDensity, uv + float3(stepUV.x,0,0),0) - _FireDensity.SampleLevel(sampler_FireDensity, uv - float3(stepUV.x,0,0),0),
        _FireDensity.SampleLevel(sampler_FireDensity, uv + float3(0,stepUV.y,0),0) - _FireDensity.SampleLevel(sampler_FireDensity, uv - float3(0,stepUV.y,0),0),
        _FireDensity.SampleLevel(sampler_FireDensity, uv + float3(0,0,stepUV.z),0) - _FireDensity.SampleLevel(sampler_FireDensity, uv - float3(0,0,stepUV.z),0)) / _VoxelSize;
    return -g * rsqrt(max(dot(g,g), 0.00000001));
}
SurfaceVertex MakeVertex(float3 gridPosition)
{
    SurfaceVertex v;
    v.positionWS = _WorldOrigin + gridPosition * _VoxelSize;
    v.pad0 = 0; v.normalWS = NormalAt(gridPosition); v.pad1 = 0;
    return v;
}
void Emit(float3 a, float3 b, float3 c)
{
    uint index; InterlockedAdd(_TriangleCounter[0], 1, index);
    if (index >= (uint)_MaximumTriangleCount) { InterlockedAdd(_OverflowCounter[0],1); return; }
    SurfaceTriangle t; t.v0=MakeVertex(a); t.v1=MakeVertex(b); t.v2=MakeVertex(c);
    // Tetra 索引在不同 Case 下会反向；按 Density Gradient 统一外向 Winding，才可以 Cull Back。
    if (dot(cross(t.v1.positionWS-t.v0.positionWS,t.v2.positionWS-t.v0.positionWS),
        t.v0.normalWS+t.v1.normalWS+t.v2.normalWS) < 0)
    { SurfaceVertex swap=t.v1; t.v1=t.v2; t.v2=swap; }
    _FireSurfaceTriangles[index]=t;
}
float3 CrossPoint(float3 a, float da, float3 b, float db)
{
    float denominator = db - da;
    float t = abs(denominator) < 0.000001 ? 0.5 : saturate((_IsoLevel-da)/denominator);
    return lerp(a,b,t);
}
void PolygoniseTetra(float3 p[4], float d[4])
{
    uint inside[4], outside[4], ni=0, no=0;
    [unroll] for(uint i=0;i<4;i++) { if(d[i]>=_IsoLevel) inside[ni++]=i; else outside[no++]=i; }
    if(ni==0 || ni==4) return;
    if(ni==1 || ni==3)
    {
        uint a=ni==1?inside[0]:outside[0];
        uint b=ni==1?outside[0]:inside[0], c=ni==1?outside[1]:inside[1], e=ni==1?outside[2]:inside[2];
        Emit(CrossPoint(p[a],d[a],p[b],d[b]),CrossPoint(p[a],d[a],p[c],d[c]),CrossPoint(p[a],d[a],p[e],d[e]));
    }
    else
    {
        // 两内两外产生四边形。按 ac→ad→bd→bc 的边界顺序拆分，不能按交点发现顺序接线。
        uint a=inside[0], b=inside[1], c=outside[0], e=outside[1];
        float3 ac=CrossPoint(p[a],d[a],p[c],d[c]), ad=CrossPoint(p[a],d[a],p[e],d[e]);
        float3 bc=CrossPoint(p[b],d[b],p[c],d[c]), bd=CrossPoint(p[b],d[b],p[e],d[e]);
        Emit(ac,ad,bd); Emit(ac,bd,bc);
    }
}

[numthreads(1,1,1)] void ClearFireSurface(uint3 id:SV_DispatchThreadID)
{ _TriangleCounter[0]=0; _OverflowCounter[0]=0; _IndirectArguments[0]=0; _IndirectArguments[1]=1; _IndirectArguments[2]=0; _IndirectArguments[3]=0; }

[numthreads(4,4,4)]
void ExtractFireSurface(uint3 id:SV_DispatchThreadID)
{
    if (_GridResolutionX <= 1 || _GridResolutionY <= 1 || _GridResolutionZ <= 1) return;
    // SV_DispatchThreadID 是 uint3；先验证 int 配置，再显式转成相同的 unsigned domain，
    // 防止 signed/unsigned mismatch 让不同 Graphics API 采用不同的隐式转换。
    uint3 maximumCell = uint3(
        (uint)(_GridResolutionX - 1),
        (uint)(_GridResolutionY - 1),
        (uint)(_GridResolutionZ - 1));
    if (any(id >= maximumCell)) return;
    static const int3 offsets[8]={int3(0,0,0),int3(1,0,0),int3(1,1,0),int3(0,1,0),int3(0,0,1),int3(1,0,1),int3(1,1,1),int3(0,1,1)};
    static const uint4 tetra[6]={uint4(0,5,1,6),uint4(0,1,2,6),uint4(0,2,3,6),uint4(0,3,7,6),uint4(0,7,4,6),uint4(0,4,5,6)};
    float3 p8[8]; float d8[8];
    [unroll] for(uint i=0;i<8;i++){int3 samplePosition=(int3)id+offsets[i];p8[i]=(float3)samplePosition;d8[i]=Sample(samplePosition);}
    [unroll] for(uint t=0;t<6;t++){float3 p[4];float d[4];uint4 q=tetra[t];p[0]=p8[q.x];p[1]=p8[q.y];p[2]=p8[q.z];p[3]=p8[q.w];d[0]=d8[q.x];d[1]=d8[q.y];d[2]=d8[q.z];d[3]=d8[q.w];PolygoniseTetra(p,d);}
}

[numthreads(1,1,1)] void BuildFireDrawArgs(uint3 id:SV_DispatchThreadID)
{ _IndirectArguments[0]=min(_TriangleCounter[0],(uint)_MaximumTriangleCount)*3; _IndirectArguments[1]=1; }
