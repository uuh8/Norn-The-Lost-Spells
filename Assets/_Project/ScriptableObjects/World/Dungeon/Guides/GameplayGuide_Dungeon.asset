  m_Name: GameplayGuide_Dungeon
  m_EditorClassIdentifier: Game.UI::Game.UI.GameplayGuideDefinition
  Pages:
  - Title: "\u8BD5\u70BC\u4E0E\u56DE\u7A0B"
    Body: "\u6E05\u7406\u56DB\u4E2A\u533A\u57DF\uFF0C\u62FE\u53D6\u6CD5\u672F\u5956\u52B1\uFF0C\u518D\u901A\u8FC7\u51FA\u53E3\u8FD4\u56DE\u636E\u70B9P7\u5165\u53E3\u5916\uFF1BBoss\u7EC3\u4E60\u4ECE\u636E\u70B9P8\u5165\u53E3\u8FDB\u5165\u3002\u4E24\u5F20\u5730\u56FE\u7684\u84DD\u8272\u56DE\u7A0B\u95E8\u53EF\u5E26\u7740\u80CC\u5305\u7269\u54C1\u8FD4\u56DE\u636E\u70B9\u3002"
  - Title: "\u79FB\u52A8\u4E0E\u65BD\u6CD5"
    Body: "WASD\u79FB\u52A8\uFF0C\u9F20\u6807\u63A7\u5236\u955C\u5934\uFF0CSpace\u8DF3\u8DC3\u30021\u30012\u30013\u5207\u6362\u6CD5\u6756\uFF0C\u9F20\u6807\u5DE6\u952E\u65BD\u653E\u5F53\u524D\u6CD5\u6756\u7A0B\u5E8F\u3002\u5C4F\u5E55\u4E2D\u5FC3\u5C0F\u767D\u70B9\u662F\u7784\u51C6\u4F4D\u7F6E\u3002"
  - Title: "\u80CC\u5305\u4E0E\u6750\u6599"
    Body: "Tab\u6253\u5F00\u80CC\u5305\uFF0C\u62D6\u52A8\u6CD5\u672F\u8FDB\u5165\u6CD5\u6756\u7A0B\u5E8F\u3002\u65B0\u6CD5\u672F\u4F18\u5148\u8FDB\u5165\u9EC4\u8272\u6CD5\u672F\u4E13\u533A\uFF0C\u6EE1\u540E\u8FDB\u5165\u80CC\u5305\uFF1B\u5956\u52B1\u88C5\u4E0D\u4E0B\u65F6\u4FDD\u7559\u9886\u53D6\u5165\u53E3\uFF0C\u5148\u6574\u7406\u80CC\u5305\u30024\u20130\u9009\u62E9\u9053\u5177\uFF1B\u5BB9\u5668\u5DE6\u952E\u6492\u51FA\uFF0CF\u91C7\u96C6\uFF0CG\u6295\u63B7\u3002F\u62FE\u53D6\u9644\u8FD1\u7269\u54C1\uFF1B\u5217\u8868\u51FA\u73B0\u65F6\u6EDA\u8F6E\u5207\u6362\u76EE\u6807\u3002"
